{
  "name": "asurwave",
  "version": "1.0.0",
  "description": "AsurWave — a modern, accessible, production-ready landing page for an AI-powered entertainment channel. Built with Vite, TypeScript and Tailwind CSS.",
  "type": "module",
  "license": "MIT",
  "author": "Aashish Bharti <aashish@marketdoctorsonline.com>",
  "homepage": "https://github.com/aashishbharti04/asurwave#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/aashishbharti04/asurwave.git"
  },
  "bugs": {
    "url": "https://github.com/aashishbharti04/asurwave/issues"
  },
  "keywords": [
    "landing-page",
    "vite",
    "typescript",
    "tailwindcss",
    "ai-entertainment",
    "static-site",
    "accessibility",
    "dark-mode",
    "open-source"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.19.19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.9.0",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
