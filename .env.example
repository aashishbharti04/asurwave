# ---------------------------------------------------------------------------
# AsurWave environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values. Only variables prefixed with
# `VITE_` are exposed to the client bundle (Vite convention). NEVER put secrets
# (API keys, tokens, passwords) in any VITE_-prefixed variable — they are
# embedded in the public build and visible to everyone.
# ---------------------------------------------------------------------------

# Canonical, absolute site URL (used for SEO meta, sitemap, and Open Graph).
VITE_SITE_URL="https://aashishbharti04.github.io/asurwave/"

# Public contact email rendered in the footer.
VITE_CONTACT_EMAIL="aashish@marketdoctorsonline.com"

# ---------------------------------------------------------------------------
# Build-time only (NOT prefixed with VITE_, so it is never shipped to clients).
# ---------------------------------------------------------------------------
# Sub-path the site is deployed under. Use "/" for a custom domain / user page,
# or "/<repo-name>/" for a GitHub Pages project site. The deploy workflow sets
# this automatically; you usually do not need to change it locally.
# BASE_PATH="/asurwave/"
